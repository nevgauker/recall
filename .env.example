# Copy to `.env` — not `.env.local`.
#
# Next.js reads both, but Prisma's CLI loads only `.env` (see prisma.config.ts),
# so a DATABASE_URL placed in `.env.local` works at runtime while migrations
# silently target the dummy fallback. Keeping everything in `.env` avoids that,
# and avoids two copies of the same key drifting apart.

# Postgres with the pgvector extension (Neon, Supabase, RDS, local).
#
# The app and `prisma migrate` share this one URL, so it must support session
# state: use Neon's unpooled endpoint (no `-pooler` in the host), or Supabase's
# session-mode pooler on port 5432. Transaction-mode poolers break migrations.
# Percent-encode any of @ : / ? # [ ] % in the password.
#
# See docs/db-provisioning.md for provisioning and verification.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# https://dashboard.clerk.com -> API keys, or run `clerk env pull`
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
